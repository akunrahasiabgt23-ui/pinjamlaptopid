# Port server aplikasi (Default: 3000)
PORT=3000

# Lingkungan aplikasi: 'development' atau 'production'
NODE_ENV=production

# Lokasi file database SQLite (Default: ./data/pinjamlaptop.db)
DB_PATH=./data/pinjamlaptop.db

# Kunci rahasia untuk enkripsi sesi cookie httpOnly
SESSION_SECRET=ganti-dengan-kunci-rahasia-panjang-acak-minimal-32-karakter

# Kredensial Administrator Utama Pertama (Dibuat otomatis ke database pada server pertama kali jalan)
# PENTING: Gunakan password yang kuat minimal 8-12 karakter!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=buatPasswordAdminKuatMinimal12Karakter!

# Kredensial Akun Staf (Opsional, di-hash dengan bcrypt saat inisialisasi jika diisi)
FINANCE_PASSWORD=buatPasswordFinanceKuat123!
OPS_PASSWORD=buatPasswordOpsKuat123!
